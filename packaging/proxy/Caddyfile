# onepackd behind Caddy with automatic TLS (Phase 7, ADR-018).
#
# - onepackd listens on 127.0.0.1:8080 with --public-url https://packages.example.com.
# - Everything is forwarded to onepackd, which authenticates each request; the data
#   directory is never served directly.
# - onepackd does not trust X-Forwarded-*. Since all requests arrive with the proxy's
#   IP, disable onepackd's per-IP limit (ONEPACK_IP_RATE_LIMIT=0) and limit here or
#   in the firewall (Caddy has no rate limiting without additional modules).

packages.example.com {
	request_body {
		# Equal to or greater than --max-package-size-mib.
		max_size 110MB
	}
	reverse_proxy 127.0.0.1:8080 {
		# Streaming uploads and downloads, no buffering in the proxy.
		flush_interval -1
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}
