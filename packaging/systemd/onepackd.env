# /etc/onepack/onepackd.env — onepackd configuration (permissions 0640, root:onepack).
# Each variable is equivalent to a `onepackd serve` flag (see `onepackd serve --help`).

ONEPACK_DATA_DIR=/var/lib/onepack
# URL used by clients: base for all protocol URLs (ADR-018).
ONEPACK_PUBLIC_URL=https://packages.example.com
# Behind a reverse proxy on the same machine, listen only on loopback.
ONEPACK_LISTEN=127.0.0.1:8080
# Metrics and probes without credentials: only on an internal interface.
ONEPACK_OPS_LISTEN=127.0.0.1:9464
ONEPACK_LOG_FORMAT=json
RUST_LOG=info
# Behind a proxy, all requests arrive with its IP: enforce the IP limit at the proxy.
ONEPACK_IP_RATE_LIMIT=0
