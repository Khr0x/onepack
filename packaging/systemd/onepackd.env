# /etc/onepack/onepackd.env — configuración de onepackd (permisos 0640, root:onepack).
# Cada variable equivale a un flag de `onepackd serve` (ver `onepackd serve --help`).

ONEPACK_DATA_DIR=/var/lib/onepack
# URL con la que llegan los clientes: base de todas las URLs del protocolo (ADR-018).
ONEPACK_PUBLIC_URL=https://packages.example.com
# Detrás de un reverse proxy en la misma máquina, escucha solo en loopback.
ONEPACK_LISTEN=127.0.0.1:8080
# Métricas y sondas sin credencial: solo en una interfaz interna.
ONEPACK_OPS_LISTEN=127.0.0.1:9464
ONEPACK_LOG_FORMAT=json
RUST_LOG=info
# Detrás de un proxy todas las peticiones llegan con su IP: limita por IP en el proxy.
ONEPACK_IP_RATE_LIMIT=0
