# onepackd systemd unit (Phase 7). Installation: packaging/README.md.
[Unit]
Description=onepack: private NuGet package registry
Documentation=https://github.com/Khr0x/onepack
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=onepack
Group=onepack
EnvironmentFile=/etc/onepack/onepackd.env
ExecStart=/usr/local/bin/onepackd serve
Restart=on-failure
RestartSec=2
# On stop, SIGTERM: finishes in-flight requests.
TimeoutStopSec=30
LimitNOFILE=65536

# Data in /var/lib/onepack, owned by the service user and with 0700 permissions.
StateDirectory=onepack
StateDirectoryMode=0700
UMask=0077

# Hardening: the process can only write to its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
