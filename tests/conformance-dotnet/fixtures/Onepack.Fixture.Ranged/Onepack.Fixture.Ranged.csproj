<Project Sdk="Microsoft.NET.Sdk">

  <!-- Depends on Onepack.Fixture.Basic with a range: restore must choose 1.1.0 among
       1.0.0, 1.1.0, and 2.0.0. When packing, Basic is resolved from the additional
       restore sources (RestoreAdditionalProjectSources). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Onepack.Fixture.Ranged</PackageId>
    <Version>1.0.0</Version>
    <Authors>onepack</Authors>
    <Description>Test package with a range dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Onepack.Fixture.Basic" Version="[1.1.0, 2.0.0)" />
  </ItemGroup>

</Project>
