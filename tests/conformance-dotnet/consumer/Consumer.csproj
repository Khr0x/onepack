<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumes packages from onepackd. Onepack.Fixture.Basic arrives only as a
       transitive dependency: Dependent requires >= 1.0.0 and Ranged [1.1.0, 2.0.0), so 1.1.0 must resolve.
       The framework is passed from the script to use the running SDK's without downloading
       reference packages from nuget.org. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ConsumerTargetFramework Condition="'$(ConsumerTargetFramework)' == ''">net8.0</ConsumerTargetFramework>
    <TargetFramework>$(ConsumerTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Onepack.Fixture.Dependent" Version="1.0.0" />
    <PackageReference Include="Onepack.Fixture.Ranged" Version="1.0.0" />
    <PackageReference Include="Onepack.Fixture.Rich" Version="2.0.0-beta.1" />
  </ItemGroup>

</Project>
